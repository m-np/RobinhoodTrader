# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Robinhood MCP
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Robinhood OAuth (needed for /auth/robinhood flow)
# Register your app at https://robinhood.com/us/en/support/articles/developer-api/
ROBINHOOD_CLIENT_ID=
ROBINHOOD_CLIENT_SECRET=
ROBINHOOD_REDIRECT_URI=http://localhost:8000/auth/robinhood/callback

# Token encryption key — REQUIRED to store OAuth tokens
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Database
DATABASE_URL=postgresql:///robinhoodtrader

# Notifications
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...
NOTIFY_TO_NUMBER=+1...
NOTIFY_EMAIL=you@example.com

# SMTP (email reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=...    # use a Gmail App Password, not your main password

# Market data (optional — improves market wave alerts)
POLYGON_API_KEY=
ALPHA_VANTAGE_KEY=

# App
DEPLOYMENT_MODE=local
AGENT_INTERVAL_MINUTES=15
MIN_WALLET_BALANCE_USD=10.0
PORT=8000
