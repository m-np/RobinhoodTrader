# ── Anthropic ────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Robinhood MCP ─────────────────────────────────────────────────────────────
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Robinhood OAuth — register your app at:
# https://robinhood.com/us/en/support/articles/developer-api/
ROBINHOOD_CLIENT_ID=
ROBINHOOD_CLIENT_SECRET=
ROBINHOOD_REDIRECT_URI=http://localhost:8000/auth/robinhood/callback

# ── Token encryption ──────────────────────────────────────────────────────────
# REQUIRED — used to encrypt stored OAuth tokens at rest.
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never share or commit the real value.
ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Docker overrides this automatically — leave as-is for both local and Docker use
DATABASE_URL=postgresql:///robinhoodtrader

# ── Notifications (optional) ──────────────────────────────────────────────────
# SMS via Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...
NOTIFY_TO_NUMBER=+1...

# Email
NOTIFY_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=...    # use a Gmail App Password, not your main password

# ── Stock discovery (optional) ────────────────────────────────────────────────
# Free/paid key at https://serper.dev — enables Google-powered stock discovery
SERPER_API_KEY=

# ── Dashboard ─────────────────────────────────────────────────────────────────
# REQUIRED — HTTP Basic Auth password for the web dashboard.
# Leave empty and the app will refuse to start.
DASHBOARD_SECRET=changeme

# ── App ───────────────────────────────────────────────────────────────────────
DEPLOYMENT_MODE=local
AGENT_INTERVAL_MINUTES=15
MIN_WALLET_BALANCE_USD=10.0
PORT=8000
